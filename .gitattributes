* text=auto
*.py text eol=lf
*.c text eol=lf
*.h text eol=lf
*.sh text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.md text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.dat text eol=lf
*.ps1 text eol=crlf
*.pdf binary
*.png binary
*.npz binary

# Keep frozen research evidence byte-identical to SHA256SUMS.json on every OS.
research/releases/transfer_20261001/** -text
# This is an inspected upstream snapshot; preserve its original whitespace.
research/releases/transfer_20261001/native_source_provenance/source_worktree_patch.diff whitespace=-trailing-space

# Preserve publication asset bytes and their provenance hashes in release archives.
manuscript/transfer_article.tex -text
manuscript/figures/** -text
manuscript/tables/** -text
scripts/build_transfer_pdf.py -text

# Release metadata and verifier are covered by the publication manifest.
CITATION.cff -text
README.md -text
DATA_AVAILABILITY.md -text
LICENSE.md -text
RELEASE_v0.31.0.txt -text
scripts/verify_transfer_publication.py -text
.gitattributes -text
.gitignore -text
TRANSFER_PUBLICATION_SHA256SUMS.json -text
